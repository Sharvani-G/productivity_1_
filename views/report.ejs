<link rel="stylesheet" href="/styles/report.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js" nonce="<%= cspNonce %>"></script>

<!-- Back Button -->
<a href="/" style="position: fixed; top: 20px; left: 20px; z-index: 9999; display: flex; align-items: center; justify-content: center; width: 50px; height: 50px; background-color: #fff; border-radius: 50%; transition: 0.2s; box-shadow: 0 2px 8px rgba(0,0,0,0.2);">
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="15 18 9 12 15 6"></polyline>
  </svg>
</a>

<div class="dashboard-body-container">
    <div class="dashboard-wrapper">
        <div class="hero-header">
            <h1 class="flashy-title">ELITE PRODUCTIVITY INSIGHTS</h1>
            <p class="hero-subtitle">Visualizing peak performance and consistency</p>
        </div>

        <div class="dashboard-grid">
            <div class="card area-s1"><h1>Efficiency</h1><p class="num" id="efficiency">--%</p></div>
            <div class="card area-s2"><h1>Completed</h1><p class="num green" id="completedCount">0</p></div>
            <div class="card area-s3"><h1>In Process</h1><p class="num yellow" id="inProcessCount">0</p></div>
            <div class="card area-s4"><h1>Abandoned</h1><p class="num red" id="abandonedCount">0</p></div>

<div class="card area-heat">
    <h1>Yearly Activity Streak</h1>
    <p class="heatmap-hint">Hover over a box to see your progress!</p> 
    
    <div class="streak-wrapper">
        <div id="heatmap" class="heatmap-grid"></div>
        <div id="heatmap-tooltip" class="custom-tooltip"></div>
    </div>
    
    <div class="heatmap-legend">
        <span class="legend-text">Low</span>
        <div class="legend-dots">
            <div class="dot lvl-0"></div><div class="dot lvl-1"></div><div class="dot lvl-2"></div><div class="dot lvl-3"></div><div class="dot lvl-4"></div>
        </div>
        <span class="legend-text">High</span>
    </div>
</div>

<div class="card area-side">
    <h1>Status Overview</h1>
    <ul class="status-list">
        <li><span class="dot-indicator green-bg"></span>Completed</li>
        <li><span class="dot-indicator yellow-bg"></span>In-Process</li>
        <li><span class="dot-indicator red-bg"></span>Abandoned</li>
    </ul>
    <div class="donut-fixed-box">
        <canvas id="statusDonut"></canvas>
    </div>
</div>

            <div class="card area-line">
                <h1 class="dash-h1">Weekly Task Overview</h1>
                <div class="segmented-control mini-btns">
                    <button class="seg-btn active" data-type="completed">Completed</button>
                    <button class="seg-btn" data-type="inprocess">In Process</button>
                    <button class="seg-btn" data-type="abandoned">Abandoned</button>
                </div>
                <div class="main-chart-box relative-box">
                    <div class="y-title-container"><span class="axis-label-sync">Completion %</span></div>
                    <div class="canvas-holder wide-canvas"><canvas id="lineChart"></canvas></div>
                    <div class="dynamic-box corner-align">
                        <span id="stat-type">Completed Avg:</span> 
                        <span id="stat-val" class="green">--%</span>
                    </div>
                </div>
                <div class="x-axis-footer axis-label-sync">Days of the Current Week</div>
            </div>

            <div class="card area-bar">
                <h1 class="dash-h1">Daily Task Distribution</h1>
                <div class="main-chart-box padded-box">
                    <div class="y-title-container"><span class="axis-label-sync">Total Tasks</span></div>
                    <div class="canvas-holder wide-canvas"><canvas id="barChart"></canvas></div>
                </div>
                <div class="x-axis-footer axis-label-sync">Weekly Timeline Breakdown</div>
            </div>
        </div>
    </div>
</div>

<script src="/js/report.js" nonce="<%= cspNonce %>"></script>