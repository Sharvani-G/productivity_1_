<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Black Edition Timer</title>
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Poppins:wght@400;600;800&display=swap" rel="stylesheet">

    <!-- Back Button -->
    <style>
        :root {
            --tap-target: 2.75rem;
        }

        html, body {
            width: 100%;
            overflow-x: hidden;
        }

        body {
            font-family: "Poppins", sans-serif;
            background-color: #000000; /* Pure Black Background */
            color: #ccdbdc; /* Dust Grey */
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            padding: clamp(1rem, 3vw, 2rem);
            box-sizing: border-box;
        }

        .container {
            background-color: #001a26; /* Darkened Deep Space Blue for the card */
            border: 0.125rem solid #007ea7; /* Cerulean border for sharp definition */
            border-radius: clamp(1rem, 4vw, 2rem);
            box-shadow: 0 0 2.5rem rgba(0, 126, 167, 0.2); /* Subtle Cerulean glow */
            padding: clamp(1.25rem, 5vw, 3.125rem) clamp(1rem, 4vw, 2.5rem);
            text-align: center;
            width: min(100%, 21.875rem);
        }

        h1 {
            font-size: clamp(1.75rem, 6vw, 2.2rem);
            font-weight: 800;
            margin-bottom: clamp(1rem, 4vw, 2.1875rem);
            letter-spacing: clamp(0.125rem, 0.8vw, 0.25rem);
            text-transform: uppercase;
            color: #ccdbdc; /* Dust Grey */
        }

        .time-inputs {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: clamp(0.375rem, 2vw, 0.75rem);
            margin-bottom: clamp(0.875rem, 4vw, 1.5625rem);
            flex-wrap: wrap;
        }

        .time-inputs input {
            width: clamp(3.5rem, 18vw, 4.6875rem);
            padding: clamp(0.625rem, 2vw, 0.75rem);
            font-family: 'Anton', sans-serif; /* Condensed numbers */
            font-size: clamp(1.25rem, 5vw, 1.75rem);
            text-align: center;
            border: 0.125rem solid #003249;
            border-radius: clamp(0.5rem, 2vw, 0.75rem);
            background-color: #000000; /* Black inputs for depth */
            color: #ffffff;
            outline: none;
            transition: 0.3s;
            min-height: var(--tap-target);
            box-sizing: border-box;
        }

        .time-inputs input:focus {
            border-color: #80ced7; /* Frosted Blue focus */
            box-shadow: 0 0 10px rgba(128, 206, 215, 0.3);
        }

        .time-inputs span {
            font-size: clamp(0.75rem, 2.5vw, 0.875rem);
            color: #80ced7;
            font-weight: 800;
        }

        #setTime {
            background-color: #ffffff; /* White button for primary action */
            color: #001a26;
            border: none;
            padding: clamp(0.625rem, 2.5vw, 0.875rem);
            border-radius: clamp(0.625rem, 2vw, 1rem);
            cursor: pointer;
            font-size: clamp(0.875rem, 2.5vw, 1rem);
            font-weight: 800;
            width: 100%;
            margin-bottom: clamp(1rem, 4vw, 1.875rem);
            transition: 0.3s;
            text-transform: uppercase;
            min-height: var(--tap-target);
        }

        #setTime:hover {
            background-color: #80ced7;
            transform: scale(1.02);
        }

        .timer {
            font-family: 'Anton', sans-serif;
            font-weight:bolder;
            font-size: clamp(2.5rem, 14vw, 5rem); /* Fluid large numbers */
            color: #ffffff;
            margin: clamp(0.625rem, 3vw, 1.25rem) 0;
            line-height: 1;
            letter-spacing: clamp(0.0625rem, 0.8vw, 0.1875rem);
            font-variant-numeric: tabular-nums;
            /* Glowing effect for high contrast */
            text-shadow: 0 0 0.9375rem rgba(255, 255, 255, 0.2); 
        }

        .controls {
            display: flex;
            gap: clamp(0.5rem, 2vw, 0.9375rem);
            margin-top: clamp(0.875rem, 4vw, 1.5625rem);
            flex-wrap: wrap;
        }

        .ctrl-btn {
            flex: 1;
            padding: clamp(0.625rem, 2.5vw, 1rem);
            font-size: clamp(0.875rem, 2.5vw, 0.9375rem);
            border: none;
            border-radius: clamp(0.5rem, 2vw, 0.875rem);
            cursor: pointer;
            font-weight: 800;
            font-family: 'Poppins', sans-serif;
            transition: 0.2s;
            min-height: var(--tap-target);
            min-width: var(--tap-target);
        }

        #start {
            background-color: #007ea7; /* Cerulean */
            color: #ffffff;
        }

        #start:hover {
            background-color: #80ced7;
            color: #001a26;
        }

        #pause {
            background-color: transparent;
            border: 0.125rem solid #80ced7;
            color: #80ced7;
        }

        #reset {
            background-color: #000000;
            border: 0.0625rem solid #ccdbdc;
            color: #ccdbdc;
        }

        .back-btn {
            position: fixed;
            top: clamp(0.625rem, 2vw, 1.25rem);
            left: clamp(0.625rem, 2vw, 1.25rem);
            z-index: 9999;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: clamp(2.75rem, 8vw, 3.125rem);
            height: clamp(2.75rem, 8vw, 3.125rem);
            background-color: #fff;
            border-radius: 50%;
            transition: transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 0.125rem 0.5rem rgba(0,0,0,0.2);
            text-decoration: none;
        }

        .back-btn:hover { transform: scale(1.05); }

        .back-btn svg {
            width: clamp(1.25rem, 4vw, 1.5rem);
            height: clamp(1.25rem, 4vw, 1.5rem);
        }

        @media (min-width: 48em) {
            .controls { flex-wrap: nowrap; }
        }

        @media (hover: none) and (pointer: coarse) {
            #setTime:hover, #start:hover { transform: none; }
            .back-btn:active, .ctrl-btn:active, #setTime:active { transform: scale(0.96); }
        }
    </style>
</head>
<body>
<!-- Back Button -->
<a href="/" class="back-btn" aria-label="Back to home">
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="15 18 9 12 15 6"></polyline>
  </svg>
</a>

    <div class="container">
        <h1>Focus</h1>

        <div class="time-inputs">
            <input type="number" id="hours" placeholder="00" min="0">
            <span>H</span>
            <input type="number" id="minutes" placeholder="00" min="0" max="59">
            <span>M</span>
            <input type="number" id="seconds" placeholder="00" min="0" max="59">
            <span>S</span>
        </div>
        
        <button id="setTime">Apply Timer</button>

        <div class="timer" id="timerDisplay">00:00:00</div>

        <div class="controls">
            <button id="start" class="ctrl-btn">Start</button>
            <button id="pause" class="ctrl-btn">Pause</button>
            <button id="reset" class="ctrl-btn">Reset</button>
        </div>
    </div>

    <script nonce="<%= cspNonce %>">
        let timerInterval;
        let totalSeconds = 0;
        let isPaused = false;

        const display = document.getElementById("timerDisplay");

        function updateDisplay() {
            let hrs = Math.floor(totalSeconds / 3600);
            let mins = Math.floor((totalSeconds % 3600) / 60);
            let secs = totalSeconds % 60;
            display.textContent =
                String(hrs).padStart(2, "0") + ":" +
                String(mins).padStart(2, "0") + ":" +
                String(secs).padStart(2, "0");
        }

        document.getElementById("setTime").addEventListener("click", () => {
            let h = parseInt(document.getElementById("hours").value) || 0;
            let m = parseInt(document.getElementById("minutes").value) || 0;
            let s = parseInt(document.getElementById("seconds").value) || 0;
            totalSeconds = h * 3600 + m * 60 + s;
            updateDisplay();
        });

        document.getElementById("start").addEventListener("click", () => {
            if (timerInterval) return;
            timerInterval = setInterval(() => {
                if (!isPaused && totalSeconds > 0) {
                    totalSeconds--;
                    updateDisplay();
                } else if (totalSeconds === 0) {
                    clearInterval(timerInterval);
                    timerInterval = null;
                }
            }, 1000);
        });

        document.getElementById("pause").addEventListener("click", () => {
            isPaused = !isPaused;
            document.getElementById("pause").textContent = isPaused ? "Resume" : "Pause";
        });

        document.getElementById("reset").addEventListener("click", () => {
            clearInterval(timerInterval);
            timerInterval = null;
            totalSeconds = 0;
            isPaused = false;
            document.getElementById("pause").textContent = "Pause";
            updateDisplay();
        });
    </script>
</body>
</html>