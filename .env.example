MONGODB_URI="your_mongodb_uri_here"
PORT=4000
API=replace_with_secret_value
JWT_SECRET=your_jwt_secret_here

# Email credentials for daily notifications (Gmail app password)
EMAIL_USER=your_gmail@example.com
EMAIL_PASS=your_16_digit_app_password
# Optional: set to 'true' to enable a temporary /test-email route (use during testing only)
ENABLE_TEST_EMAIL_ROUTE=false
