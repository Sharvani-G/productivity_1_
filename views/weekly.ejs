<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Weekly Planner</title>
    <link rel="stylesheet" href="/index.css">
    <style>
        /* Page-scoped styles: preserve original desktop look and add safe responsiveness */
        .weekly-page { overflow-x: hidden; }

        .weekly-page .back-btn-weekly {
            position: fixed;
            top: 1.25rem;
            left: 1.25rem;
            z-index: 9999;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 3.125rem;
            height: 3.125rem;
            background-color: #fff;
            border-radius: 50%;
            transition: transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 0.125rem 0.5rem rgba(0,0,0,0.2);
            text-decoration: none;
        }

        .weekly-page .back-btn-weekly:hover { transform: scale(1.05); }

        .weekly-page .back-btn-weekly svg {
            width: 1.5rem;
            height: 1.5rem;
        }

        .weekly-page .weekly-mascot {
            margin-left: 6.25rem;
            margin-top: 6.25rem;
            margin-bottom: 0.75rem;
        }

        .weekly-page #calendar {
            margin: 0;
            width: 2.5rem;
            height: 2.5rem;
        }

        .weekly-page .part1 {
            margin-left: 6.25rem;
            margin-right: 6.25rem;
            padding: 0;
            box-sizing: border-box;
        }

        .weekly-page .whead {
            font-size: 2rem;
            font-weight: 800;
            margin: 0.625rem 0 1rem;
            letter-spacing: 0.1em;
        }

        .weekly-page .planner-body { width: 100%; padding: 0; }

        .weekly-page .content-view h2 {
            font-size: 2rem;
            margin-bottom: 0.75rem;
            line-height: 1.15;
        }

        /* Only target the intro paragraph, not task-card text */
        .weekly-page .content-view > p {
            font-size: 1.25rem;
            margin-bottom: 1.5rem;
            line-height: 1.35;
        }

        .weekly-page .week-calendar {
            display: grid;
            grid-template-columns: repeat(7, minmax(0, 1fr));
            grid-template-rows: 3.125rem;
            grid-auto-rows: minmax(11.25rem, auto);
            gap: 0.625rem;
            width: 100%;
        }

        .weekly-page .week-calendar .header {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.5rem;
            font-size: 1rem;
            font-weight: 600;
        }

        .weekly-page .week-date-header { grid-column: 1 / span 6; justify-content: flex-start; }
        .weekly-page .week-nav-header { grid-column: 7 / span 1; }

        .weekly-page #date {
            margin: 0;
            font-size: 0.9rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .weekly-page #pre-week,
        .weekly-page #post-week {
            min-width: 2.75rem;
            min-height: 2.75rem;
            padding: 0.5rem 0.75rem;
            font-size: 1rem;
            font-weight: 600;
            margin-right: 0;
        }

        .weekly-page .week-calendar .content {
            min-height: 11.25rem;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 0.625rem;
        }

        .weekly-page .week-calendar .content .date {
            margin: 0.25rem 0 0.5rem;
            font-size: 1.75rem;
            line-height: 1.1;
        }

        .weekly-page .week-calendar .content .add-task {
            min-width: 2.75rem;
            min-height: 2.75rem;
            padding: 0.5rem 0.875rem;
            right: 0.75rem;
            bottom: 0.75rem;
        }

        /* Compact card internals and prevent text/button overflow */
        .weekly-page .task-card {
            width: 100%;
            max-width: 100%;
            overflow: hidden;
            padding: 0.5rem;
            margin-bottom: 0.5rem;
        }

        .weekly-page .task-card input[type="text"],
        .weekly-page .task-card p {
            width: 100%;
            max-width: 100%;
            overflow-wrap: anywhere;
            word-break: break-word;
            box-sizing: border-box;
        }

        .weekly-page .task-card .task-actions {
            display: grid !important;
            grid-template-columns: 1fr 1fr;
            width: 100%;
            gap: 0.375rem;
            margin-top: 0.375rem;
        }

        .weekly-page .task-card .task-actions button {
            width: 100%;
            min-width: 0;
            min-height: 2.25rem;
            padding: 0.375rem 0.5rem;
            font-size: 0.8rem;
            line-height: 1.1;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .weekly-page .task-card .status {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 0.25rem;
            margin-top: 0.375rem;
        }

        .weekly-page .task-card .status label {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 0.3125rem;
            font-size: 0.82rem;
            line-height: 1.15;
            padding: 0;
            overflow-wrap: anywhere;
        }

        .weekly-page .task-card .status input[type="radio"] {
            margin: 0;
            flex: 0 0 auto;
        }

        /* Tablet + mobile: stack day cards vertically */
        @media (max-width: 64em) {
            .weekly-page .weekly-mascot,
            .weekly-page .part1 {
                margin-left: 1rem;
                margin-right: 1rem;
            }

            .weekly-page .whead { font-size: clamp(1.55rem, 6vw, 1.95rem); }
            .weekly-page .content-view h2 { font-size: clamp(1.35rem, 5.5vw, 1.85rem); }
            .weekly-page .content-view > p { font-size: clamp(0.95rem, 3.2vw, 1.1rem); }

            .weekly-page .week-calendar {
                grid-template-columns: 1fr;
                grid-template-rows: auto;
                grid-auto-rows: minmax(12rem, auto);
                gap: 0.75rem;
            }

            .weekly-page .week-date-header,
            .weekly-page .week-nav-header {
                grid-column: 1 / -1;
            }

            .weekly-page .week-date-header {
                justify-content: center;
                text-align: center;
            }

            .weekly-page .week-nav-header {
                justify-content: center;
                gap: 0.75rem;
            }

            .weekly-page .week-calendar .content {
                min-height: 12rem;
            }

            .weekly-page .task-card .task-actions button {
                min-height: 2.5rem;
                font-size: 0.86rem;
            }

            .weekly-page .task-card .status label {
                font-size: 0.9rem;
            }
        }

        @media (hover: none) and (pointer: coarse) {
            .weekly-page .back-btn-weekly:hover { transform: none; }
            .weekly-page .back-btn-weekly:active { transform: scale(0.9); }
        }
    </style>
</head>
<body class="weekly-page">
    <!-- Back Button - Responsive -->
    <a href="/" class="back-btn-weekly" aria-label="Back to home">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </a>
    
    <!-- Calendar icon section -->
    <section class="weekly-mascot">  
