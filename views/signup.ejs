<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign Up | Productivity Tracker</title>

  <!-- Poppins font (self-hosted) -->
  <link href="/styles/poppins.css" rel="stylesheet">

  <style>
    body {
      margin: 0;
      padding: 0;
      min-height: 100vh;
      background: linear-gradient(180deg, #000814, #001d3d, #003566);
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: 'Poppins', sans-serif;
      overflow-x: hidden;
    }

    .signup-box {
      background: #ffffff;
      width: min(90vw, 23.75rem);
      border-radius: clamp(0.625rem, 2vw, 0.75rem);
      padding: clamp(1.25rem, 5vw, 2.5rem) clamp(1rem, 4vw, 2.1875rem);
      box-shadow: 0 0.5rem 1.5625rem rgba(0, 0, 0, 0.5);
    }

    .signup-box h2 {
      text-align: center;
      margin-bottom: clamp(0.875rem, 4vw, 1.5625rem);
      color: #001d3d;
      font-weight: 700;
      font-size: clamp(1.25rem, 4vw, 1.75rem);
    }

    label {
      display: block;
      font-weight: 600;
      color: #000814;
      margin-top: clamp(0.5rem, 2vw, 0.625rem);
      margin-bottom: clamp(0.25rem, 1vw, 0.3125rem);
    }

    input {
      width: 100%;
      padding: clamp(0.625rem, 2vw, 0.75rem);
      border: 0.0625rem solid #001d3d;
      border-radius: 0.5rem;
      background: #f8f9fa;
      font-size: clamp(0.875rem, 2vw, 1rem);
      outline: none;
      min-height: 2.75rem;
      box-sizing: border-box;
    }

    .password-container {
      position: relative;
      display: flex;
      align-items: center;
    }

    .password-container span {
      position: absolute;
      right: clamp(0.625rem, 2.5vw, 0.9375rem);
      color: #001d3d;
      font-weight: 600;
      cursor: pointer;
      user-select: none;
      font-size: clamp(0.75rem, 2vw, 0.875rem);
      min-height: 2.75rem;
      display: inline-flex;
      align-items: center;
    }

    button {
      width: 100%;
      padding: clamp(0.625rem, 2vw, 0.75rem);
      margin-top: clamp(0.875rem, 3vw, 1.25rem);
      border: none;
      border-radius: 0.5rem;
      background: #001d3d;
      color: #fff;
      font-size: clamp(0.875rem, 2vw, 1rem);
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s;
      min-height: 2.75rem;
    }

    button:hover {
      background: #000814;
    }

    .login-text {
      text-align: center;
      margin-top: clamp(0.875rem, 3vw, 1.25rem);
      color: #001d3d;
    }

    .login-text a {
      color: #001d3d;
      text-decoration: none;
      font-weight: 600;
    }

    .login-text a:hover {
      text-decoration: underline;
    }

    .feedback {
      font-size: clamp(0.688rem, 1.8vw, 0.75rem);
      margin-top: 0.1875rem;
      color: red;
      display: none;
    }

    .feedback.show {
      display: block;
    }

    .input.is-invalid {
      border-color: #dc3545 !important;
    }

    .input.is-valid {
      border-color: #28a745 !important;
    }

    @media (hover: none) and (pointer: coarse) {
      button:hover {
        background: #001d3d;
      }
    }
  </style>
</head>

<body>
  <div class="signup-container">
    <div class="signup-box">
      <h2>Sign up</h2>
      <form id="signupForm">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" placeholder="Enter your email" required>

        <label for="username">Username</label>
        <input type="text" id="username" name="username" placeholder="Enter your username" required>

        <label for="password">Password</label>
        <div class="password-container">
          <input type="password" id="password" name="password" placeholder="Enter your password" required class="input">
          <span id="togglePassword">Show</span>
        </div>
        <div class="feedback" id="passwordFeedback">Password must be 6+ characters with letters and numbers</div>

        <button type="submit" id="submitBtn">Sign Up</button>
      </form>

      <p class="login-text">Already have an account? <a href="/login">Login</a></p>
    </div>
  </div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

<script nonce="<%= cspNonce %>">
  const togglePassword = document.querySelector('#togglePassword');
  const password = document.querySelector('#password');
  const passwordFeedback = document.getElementById('passwordFeedback');
  const submitBtn = document.getElementById('submitBtn');

  // Password validation: 6+ chars, at least 1 letter, at least 1 number
  const passwordPattern = /^(?=.*[A-Za-z])(?=.*\d)[A-Za-z\d@$!%*?&]{6,}$/;

  togglePassword.addEventListener('click', () => {
    const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
    password.setAttribute('type', type);
    togglePassword.textContent = type === 'password' ? 'Show' : 'Hide';
  });

  // Real-time password validation
  password.addEventListener('input', () => {
    if (passwordPattern.test(password.value)) {
      password.classList.add('is-valid');
      password.classList.remove('is-invalid');
      passwordFeedback.classList.remove('show');
      submitBtn.disabled = false;
    } else {
      password.classList.add('is-invalid');
      password.classList.remove('is-valid');
      passwordFeedback.classList.add('show');
      submitBtn.disabled = true;
    }
  });

  document.querySelector("#signupForm").addEventListener("submit", async (e) => {
    e.preventDefault();

    const email = document.getElementById("email").value.trim();
    const username = document.getElementById("username").value.trim();
    const passwordVal = document.getElementById("password").value.trim();

    // Client-side validation
    if (!passwordPattern.test(passwordVal)) {
      alert('Password must be 6+ characters with letters and numbers');
      return;
    }

    try {
      // Use a relative URL so the same origin (port) is used for requests
      const response = await fetch("/signup", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, username, password: passwordVal })
      });

      const data = await response.json();

      if (response.ok && data.success) {
        // Auto-login after signup
        if (data.token) localStorage.setItem('token', data.token);
        localStorage.setItem('username', data.username || username);
        localStorage.setItem('userEmail', email);

        window.location.href = '/';
      } else {
        alert(data.message || 'Signup failed');
      }
    } catch (error) {
      console.error(error);
      alert("Something went wrong! Please try again later.");
    }
  });
</script>

<script src="/public/main.js"></script>
</body>
</html>
