<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Notes</title>
  <link rel="stylesheet" href="/notes_app/styles/layout.css">
  <link rel="stylesheet" href="/notes_app/styles/themes.css">
  <link rel="stylesheet" href="/notes_app/styles/notes.css">
  <style>
    /* Responsive back button shared pattern */
    .back-btn {
      position: fixed;
      top: clamp(0.625rem, 2vw, 1.25rem);
      left: clamp(0.625rem, 2vw, 1.25rem);
      z-index: 9999;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: clamp(2.75rem, 8vw, 3.125rem);
      height: clamp(2.75rem, 8vw, 3.125rem);
      background-color: #fff;
      border-radius: 50%;
      box-shadow: 0 0.125rem 0.5rem rgba(0, 0, 0, 0.2);
      transition: transform 0.2s, box-shadow 0.2s;
      text-decoration: none;
    }

    .back-btn:hover {
      transform: scale(1.05);
      box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.28);
    }

    .back-btn svg {
      width: clamp(1.25rem, 4vw, 1.5rem);
      height: clamp(1.25rem, 4vw, 1.5rem);
    }

    /* Modal styles moved from inline fixed px into responsive classes */
    .edit-modal {
      display: none;
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.5);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      box-sizing: border-box;
    }

    .edit-modal-content {
      background: var(--card, #fff);
      padding: clamp(0.875rem, 3vw, 1.25rem);
      border-radius: clamp(0.5rem, 2vw, 0.75rem);
      width: min(90vw, 31.25rem);
      box-shadow: 0 0.25rem 0.375rem rgba(0, 0, 0, 0.3);
      color: var(--text, #000);
    }

    .edit-modal-title {
      margin-top: 0;
      color: var(--text, #000);
      font-size: clamp(1.125rem, 3.5vw, 1.5rem);
    }

    .edit-actions {
      margin-top: clamp(0.75rem, 2vw, 0.9375rem);
      display: flex;
      gap: clamp(0.5rem, 2vw, 0.625rem);
      justify-content: flex-end;
      flex-wrap: wrap;
    }

    .edit-btn {
      padding: clamp(0.5rem, 2vw, 0.625rem) clamp(0.875rem, 2.5vw, 1rem);
      border: none;
      border-radius: 0.25rem;
      cursor: pointer;
      min-height: 2.75rem;
      font-size: clamp(0.875rem, 2vw, 1rem);
    }

    .edit-btn-cancel { background: #ccc; color: #000; }
    .edit-btn-save { background: #2563eb; color: #fff; font-weight: 600; }
  </style>
</head>
<body>
  <!-- Back Button -->
  <a href="/" class="back-btn" aria-label="Back to home">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#000" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </a>
  
  <main class="app">
    <header class="app-header">
      <h1>📝 My Notes</h1>
      <nav class="header-actions">
        <button id="themeToggle" class="btn">Theme</button>
      </nav>
    </header>

    <section class="composer">
      <textarea id="noteInput" placeholder="Write a note..." aria-label="note-input"></textarea>
      <div class="composer-row">
        <select id="categorySelect" aria-label="note-category">
          <option value="General">General</option>
          <option value="Study">Study</option>
          <option value="Work">Work</option>
          <option value="Personal">Personal</option>
          <option value="Ideas">Ideas</option>
          <option value="Todo">Todo</option>
        </select>
        <label><input type="checkbox" id="insertTop"> Insert top</label>
        <button id="addBtn" class="btn">Add</button>
      </div>
      <div class="composer-row">
        <button id="downloadBtn" class="btn ghost">Download This</button>
      </div>
      <div class="composer-hint">✨ Color-coded boxes • Pin favorites • Organize by category • Track todos • Light/Dark/Black themes</div>
    </section>

    <section class="controls">
      <input id="search" placeholder="Search notes by text..." />
      <select id="filterCategory" aria-label="filter-category">
        <option value="">All Categories</option>
        <option value="General">General</option>
        <option value="Study">Study</option>
        <option value="Work">Work</option>
        <option value="Personal">Personal</option>
        <option value="Ideas">Ideas</option>
        <option value="Todo">Todo</option>
      </select>
    </section>

    <section id="notesList" class="notes-list" aria-live="polite"></section>
  </main>

  <!-- Edit Modal -->
  <div id="editModal" class="edit-modal">
    <div class="edit-modal-content">
      <h2 class="edit-modal-title">Edit Note</h2>
      <textarea id="editInput"></textarea>
      <div class="edit-actions">
        <button id="cancelEdit" class="edit-btn edit-btn-cancel">Cancel</button>
        <button id="saveEdit" class="edit-btn edit-btn-save">Save</button>
      </div>
    </div>
  </div>

  <script src="/notes_app/js/api.js" type="module"></script>
  <script src="/notes_app/js/notes_app.js" type="module" nonce="<%= cspNonce %>"></script>
</body>
</html>
